# Copy this file to secrets.yaml and fill in your values

# Home Assistant API encryption key (generate with: openssl rand -base64 32)
api_encryption_key: "your-base64-api-key-here"

# OTA password for over-the-air updates
ota_password: "your-ota-password-here"

# WiFi credentials (if using WiFi fallback)
wifi_ssid: "YourWiFiSSID"
wifi_password: "YourWiFiPassword"

# =============================================================
# MQTT Configuration (for INSTANT bidirectional updates)
# =============================================================
# This enables:
#   - Instant speed readings to Home Assistant
#   - Instant config changes from the add-on UI
#
# For LOCAL radars: Use your Home Assistant's Mosquitto add-on
# For REMOTE radars: Use a cloud MQTT broker or expose Mosquitto

# Home Assistant Mosquitto add-on (local network):
mqtt_broker: "192.168.1.100"  # Your HA IP or hostname
mqtt_port: "1883"
mqtt_username: "mqtt_user"    # Create in Mosquitto add-on config
mqtt_password: "mqtt_password"

# Cloud broker example (for remote radars):
# mqtt_broker: "broker.hivemq.com"
# mqtt_port: "1883"  # or 8883 for TLS
# mqtt_username: "your_username"
# mqtt_password: "your_password"
